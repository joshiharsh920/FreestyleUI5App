<mvc:View
    height="100%"
    controllerName="joshi.project1trial.view.customer.csreg"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <NavContainer id="wizardNavContainer2">
        <pages>
            <Page id="wizardContentPag">
                <customHeader>
                    <OverflowToolbar>
                        <Button
                            type="Back"
                            icon="sap-icon://home"
                            press="onNavigateToHome"
                            tooltip="Go to Home"
                        />
                        <ToolbarSpacer />
                        <Title
                            text="Customer Registration"
                            textAlign="Center"
                            titleStyle="H4"
                        />
                        <ToolbarSpacer />
                    </OverflowToolbar>
                </customHeader>
                <content>
                    <Wizard
                        id="CreateProductWizard2"
                        class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                        complete=".wizardCompletedHandler"
                    >
                        <WizardStep
                            id="CustomerStep1"
                            title="Customer Details"
                            validated="true"
                            complete="fnStep1Complete"
                            activate="fnStep1Activate"
                        >
                            <VBox class="sapUiMediumMargin">
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Customer ID"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{csregModel>/Customerid}"
                                        placeholder="Enter Customer ID"
                                        class="sapUiMediumMarginEnd"
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 4: ID Type & ID Number -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="ID Type"
                                        width="120px"
                                    />
                                    <Select
                                        width="200px"
                                        selectedKey="{csregModel>/Id}"
                                        class="sapUiMediumMarginEnd"
                                    >
                                        <items>
                                            <core:Item
                                                key="PAN"
                                                text="PAN Card"
                                            />
                                            <core:Item
                                                key="AADHAR"
                                                text="Aadhar Card"
                                            />
                                            <core:Item
                                                key="PASSPORT"
                                                text="Passport"
                                            />
                                        </items>
                                    </Select>

                                    <Label
                                        text="ID Number"
                                        width="120px"
                                    />
                                    <Input
                                        value="{csregModel>/Idnumber}"
                                        placeholder="Enter ID number"
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 1: First Name & Last Name -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="First Name"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{csregModel>/Zfirstname}"
                                        placeholder="John"
                                        class="sapUiMediumMarginEnd"
                                        width="200px"
                                    />

                                    <Label
                                        text="Last Name"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{csregModel>/Zlastname}"
                                        placeholder="Doe"
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 2: Age & Religion -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Age"
                                        width="120px"
                                    />
                                    <Input
                                        type="Number"
                                        value="{csregModel>/Age}"
                                        placeholder="00"
                                        class="sapUiMediumMarginEnd"
                                        width="200px"
                                    />

                                    <Label
                                        text="Religion"
                                        width="120px"
                                    />
                                    <ComboBox
                                        selectedKey="{csregModel>/Religion}"
                                        placeholder="Select religion"
                                        width="200px"
                                    >
                                        <items>
                                            <core:Item
                                                key="Hindu"
                                                text="Hindu"
                                            />
                                            <core:Item
                                                key="Muslim"
                                                text="Muslim"
                                            />
                                            <core:Item
                                                key="Christian"
                                                text="Christian"
                                            />
                                            <core:Item
                                                key="Sikh"
                                                text="Sikh"
                                            />
                                        </items>
                                    </ComboBox>
                                </HBox>

                                <!-- Row 3: Email & Phone -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Email Address"
                                        width="120px"
                                    />
                                    <Input
                                        type="Email"
                                        value="{csregModel>/Email}"
                                        placeholder="email@example.com"
                                        class="sapUiMediumMarginEnd"
                                        width="200px"
                                    />

                                    <Label
                                        text="Phone Number"
                                        width="120px"
                                    />
                                    <Input
                                        type="Tel"
                                        value="{csregModel>/Phonenumber}"
                                        placeholder="+1..."
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 5: Full Address (TextArea) -->
                                <HBox
                                    alignItems="Start"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Home Address"
                                        width="120px"
                                        class="sapUiSmallMarginTop"
                                    />
                                    <TextArea
                                        rows="3"
                                        width="545px"
                                        value="{csregModel>/Homeadd}"
                                        placeholder="Enter complete residential address..."
                                    />
                                </HBox>

                                <!-- Row 6: Customer Remarks -->
                                <HBox alignItems="Start">
                                    <Label
                                        text="Remarks"
                                        width="120px"
                                        class="sapUiSmallMarginTop"
                                    />
                                    <TextArea
                                        rows="2"
                                        width="545px"
                                        value="{csregModel>/Remarks}"
                                        placeholder="Any additional notes..."
                                    />
                                </HBox>
                            </VBox>
                        </WizardStep>
                        <WizardStep
                            id="CustomerStep2"
                            title="Finance Details"
                            validated="true"
                            activate="fnStep2Activate"
                            complete="fnStep2Complete"
                        >
                            <VBox class="sapUiMediumMargin">
                                <!-- Row 1: Customer ID & Account Number -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Customer ID"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{financeModel>/Customerid}"
                                        enabled="false"
                                        width="200px"
                                        class="sapUiMediumMarginEnd"
                                    />

                                    <Label
                                        text="Account Number"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{financeModel>/Accno}"
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 2: First Name & Last Name -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="First Name"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{financeModel>/Accholderfirstname}"
                                        width="200px"
                                        class="sapUiMediumMarginEnd"
                                    />

                                    <Label
                                        text="Last Name"
                                        width="120px"
                                        required="true"
                                    />
                                    <Input
                                        value="{financeModel>/Accholderlastname}"
                                        width="200px"
                                    />
                                </HBox>

                                <!-- Row 3: Address -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Address"
                                        width="120px"
                                    />
                                    <Input
                                        value="{financeModel>/Accholderaddress}"
                                        width="520px"
                                    />
                                </HBox>

                                <!-- Row 4: Bank Name & Account Type -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Bank Name"
                                        width="120px"
                                    />
                                    <Input
                                        value="{financeModel>/Bankname}"
                                        width="200px"
                                        class="sapUiMediumMarginEnd"
                                    />

                                    <Label
                                        text="Account Type"
                                        width="120px"
                                    />
                                    <Select
                                        selectedKey="{financeModel>/Acctype}"
                                        width="200px"
                                    >
                                        <items>
                                            <core:Item
                                                key="SAVINGS"
                                                text="Savings"
                                            />
                                            <core:Item
                                                key="CURRENT"
                                                text="Current"
                                            />
                                            <core:Item
                                                key="SALARY"
                                                text="Salary"
                                            />
                                        </items>
                                    </Select>
                                </HBox>

                                <!-- Row 5: Annual Income -->
                                <HBox
                                    alignItems="Center"
                                    class="sapUiSmallMarginBottom"
                                >
                                    <Label
                                        text="Annual Income"
                                        width="120px"
                                    />
                                    <Input
                                        value="{financeModel>/Annualincome}"
                                        width="200px"
                                        type="Number"
                                    />
                                </HBox>
                            </VBox>
                        </WizardStep>
                        <WizardStep
                            id="CustomerStep3"
                            title="Review Details"
                            validated="true"
                        >
                            <VBox class="sapUiMediumMargin">
                                <!-- Personal Details -->
                                <Title
                                    text="Customer Details"
                                    level="H5"
                                />

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="First Name:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Zfirstname}" />
                                </HBox>

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="Last Name:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Zlastname}" />
                                </HBox>

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="Email:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Email}" />
                                </HBox>

                                <!-- Finance Details -->
                                <Title
                                    text="Finance Details"
                                    level="H5"
                                />

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="Account Number:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Accno}" />
                                </HBox>

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="Bank Name:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Bankname}" />
                                </HBox>

                                <HBox class="sapUiSmallMarginBottom">
                                    <Text
                                        text="Income:"
                                        width="150px"
                                    />
                                    <Text text="{reviewModel>/Annualincome}" />
                                </HBox>
                            </VBox>
                        </WizardStep>
                        <WizardStep
                            id="CustomerStep4"
                            title="Product Details"
                            validated="true"
                        >
                            <MessageStrip
                                text="This is fourth wizard step"
                                showIcon="true"
                            />
                        </WizardStep>
                    </Wizard>
                </content>
            </Page>
            <Page id="wizardSummaryPag2">
                <content>
                    <Title text="Summary" />
                </content>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>
